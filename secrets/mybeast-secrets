#!/usr/bin/env bash
# mybeast-secrets - My Beast Secrets on a machine: one environment's variables, read with a service token.
#
#   mybeast-secrets pull [--out FILE] [--force]   write them to a .env (FILE, default .env; - for stdout)
#   mybeast-secrets run -- COMMAND [ARGS...]      run COMMAND with them in its environment; nothing is written
#
# Reads MYBEAST_SECRETS_URL (e.g. https://services.my-beast.com/secrets) and MYBEAST_SECRETS_TOKEN (st_….…, made on the project's
# Secrets → Tokens page). Bash and curl, nothing else; bash 3.2 (macOS) and up. The token goes to curl on its
# standard input, never on its command line, where other users' `ps` would see it.

set -euo pipefail

VERSION=1
SELF=${0##*/}

die() {
    printf '%s: %s\n' "$SELF" "$*" >&2
    exit 1
}

usage() {
    cat <<EOF
$SELF $VERSION - My Beast Secrets on a machine

  $SELF pull [--out FILE] [--force]   write the environment's variables to a .env
                                       (FILE: default .env; - for standard output)
  $SELF run -- COMMAND [ARGS...]      run COMMAND with the variables; nothing is written

Needs MYBEAST_SECRETS_URL and MYBEAST_SECRETS_TOKEN (a service token: the project's Secrets → Tokens).
pull overwrites only a file it wrote itself; --force overwrites any.
EOF
}

settings() {
    [ -n "${MYBEAST_SECRETS_URL:-}" ] || die "MYBEAST_SECRETS_URL is not set (e.g. https://services.my-beast.com/secrets)"
    [ -n "${MYBEAST_SECRETS_TOKEN:-}" ] || die "MYBEAST_SECRETS_TOKEN is not set (a service token: the project's Secrets → Tokens)"
    case $MYBEAST_SECRETS_URL in
        https://* | http://localhost* | http://127.0.0.1* | http://*.localhost* | http://*.test*) ;;
        *) die "MYBEAST_SECRETS_URL must be https:// (plain http only for localhost, *.localhost and *.test)" ;;
    esac
    [[ $MYBEAST_SECRETS_TOKEN =~ ^st_[a-z0-9]+\.[A-Za-z0-9_-]+$ ]] || die "MYBEAST_SECRETS_TOKEN does not look like a service token (st_….…)"
    command -v curl >/dev/null 2>&1 || die "curl is needed"
}

# fetch FORMAT FILE: the token's environment in FORMAT (env or shell) into FILE, or a plain reason why not.
fetch() {
    local code
    code=$(printf 'header = "Authorization: Bearer %s"\n' "$MYBEAST_SECRETS_TOKEN" |
        curl --silent --show-error --proto '=https,http' --max-time 30 --config - \
            --header 'Accept: text/plain' --output "$2" --write-out '%{http_code}' \
            "${MYBEAST_SECRETS_URL%/}/api/v1/secrets?format=$1") || die "could not reach $MYBEAST_SECRETS_URL"

    case $code in
        200) ;;
        401) die "the token was refused: revoked, mistyped, or not a token of $MYBEAST_SECRETS_URL" ;;
        429) die "too many reads just now; try again in a minute" ;;
        *) die "$MYBEAST_SECRETS_URL answered $code" ;;
    esac
}

TMP=
cleanup() {
    if [ -n "$TMP" ]; then rm -f "$TMP"; fi
}
trap cleanup EXIT

pull() {
    local out=.env force=0
    while [ $# -gt 0 ]; do
        case $1 in
            --out) [ $# -ge 2 ] || die "--out needs a file"; out=$2; shift 2 ;;
            --out=*) out=${1#--out=}; shift ;;
            --force) force=1; shift ;;
            -h | --help) usage; exit 0 ;;
            *) die "pull does not take $1 (see $SELF --help)" ;;
        esac
    done
    settings

    if [ "$out" = - ]; then
        TMP=$(umask 077 && mktemp "${TMPDIR:-/tmp}/mybeast-secrets.XXXXXX")
        fetch env "$TMP"
        cat "$TMP"
        return
    fi

    # Only ever over a file this command wrote (its first line says so), unless told otherwise: a hand-made .env is
    # not lost to a pull by mistake.
    if [ -e "$out" ] && [ $force -eq 0 ]; then
        local first=
        IFS= read -r first <"$out" || true
        case $first in
            '# MyBeast Secrets '*) ;;
            *) die "$out was not written by $SELF; move it away, or pull with --force to overwrite it" ;;
        esac
    fi

    # Written next to its place and moved there whole: a reader never sees half a file. Readable by its owner only.
    TMP=$(umask 077 && mktemp "$(dirname -- "$out")/.mybeast-secrets.XXXXXX") || die "cannot write in $(dirname -- "$out")"
    fetch env "$TMP"
    chmod 600 "$TMP"
    mv -f -- "$TMP" "$out"
    TMP=

    local head=
    IFS= read -r head <"$out" || true
    printf '%s: wrote %s (%s)\n' "$SELF" "$out" "${head#\# }" >&2
}

run() {
    [ "${1:-}" = -- ] && shift
    [ $# -gt 0 ] || die "run needs a command: $SELF run -- COMMAND [ARGS...]"
    settings

    TMP=$(umask 077 && mktemp "${TMPDIR:-/tmp}/mybeast-secrets.XXXXXX")
    fetch shell "$TMP"

    # Each line must be exactly `export NAME=$'…'` with every unsafe byte as \xHH: then it is decoded, never run.
    local line name encoded value
    local shape='^export ([A-Z][A-Z0-9_]*)=\$'"'"'(([A-Za-z0-9 _./:@%+,=-]|\\x[0-9a-f][0-9a-f])*)'"'"'$'
    while IFS= read -r line || [ -n "$line" ]; do
        [[ $line =~ $shape ]] || die "the answer has a line that is not a variable; nothing was run"
        name=${BASH_REMATCH[1]}
        encoded=${BASH_REMATCH[2]}
        # bash 3.2's printf -v leaves the variable as it was when there is nothing to print: an empty value is set here.
        value=
        [ -z "$encoded" ] || printf -v value '%b' "$encoded"
        export "$name=$value"
    done <"$TMP"

    rm -f "$TMP"
    TMP=
    exec "$@"
}

case ${1:-} in
    pull) shift; pull "$@" ;;
    run) shift; run "$@" ;;
    -h | --help | help | '') usage ;;
    -v | --version) printf '%s %s\n' "$SELF" "$VERSION" ;;
    *) die "unknown command $1 (see $SELF --help)" ;;
esac
